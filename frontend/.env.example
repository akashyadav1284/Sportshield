# SportShield AI Frontend — Environment Variables
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Set these in Vercel Dashboard → Settings → Environment Variables

# Backend API URL (your deployed backend)
# Example: https://your-backend.onrender.com/api/v1
VITE_API_URL=/api/v1

# WebSocket URL (your deployed backend root)
# Example: https://your-backend.onrender.com
VITE_WS_URL=/
